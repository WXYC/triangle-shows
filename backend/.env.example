DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/triangle_shows
TICKETMASTER_API_KEY=your_key_here
ENABLE_SCHEDULER=false
APP_ENV=development
LOG_LEVEL=INFO
# Any random secret. Empty (the default) disables .ics feed telemetry entirely.
TELEMETRY_SALT=
# Opt-in exception tracker (Sentry) DSN. Empty (the default) disables the tracker
# entirely — internal errors still go to the container log stream (stderr) at
# ERROR with a stack trace either way. See backend/app/sentry_hook.py.
SENTRY_DSN=
# Opt-in push delivery, scrape-health digests only (not internal errors — those
# always go to stderr and, if configured, Sentry). A generic {"text": ...} JSON
# POST that Slack and Mattermost accept as-is, and Discord accepts too if you
# append "/slack" to its webhook URL. Empty (the default) logs instead of posting.
# Inert until the scrape-health digest (issue #86) lands — nothing produces to
# this yet, so setting it early is harmless but silent.
ALERT_WEBHOOK_URL=
